# Copy to .env and fill in. .env is git-ignored and must never be committed.

APP_NAME="Kishan Modhu"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://kishanmodhu.com
APP_TIMEZONE=Asia/Dhaka

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kishanmodhu
DB_USERNAME=
DB_PASSWORD=

# Sign an admin out after this many seconds of inactivity (0 disables).
SESSION_IDLE_TIMEOUT=7200

# Maximum media upload size in bytes (5 MB).
MAX_UPLOAD_BYTES=5242880

# Uploaded files are data, never code.
#
# The uploader already restricts extensions by sniffed MIME type; this is the
# second line of defence in case a handler is ever misconfigured.

php_flag engine off

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|phar|phtml|php[0-9]|pl|py|cgi|sh|htaccess)$">
    Require all denied
</FilesMatch>

Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8
